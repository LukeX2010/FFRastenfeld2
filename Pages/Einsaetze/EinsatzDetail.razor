@page "/einsaetze/{Slug}"
@inject DataService DS
@inject NavigationManager Nav

<PageTitle>@(post?.Titel ?? "Einsatz") – FF Rastenfeld, Niederösterreich</PageTitle>

@if (post is null)
{
    <div class="container" style="padding:4rem 1.5rem;text-align:center">
        <p>Einsatz nicht gefunden. <a href="/einsaetze">← Zurück</a></p>
    </div>
}
else
{
    <PageHero Title="@post.Titel" ParentLabel="Einsätze" ParentHref="/einsaetze" />

    <div class="site-body container">
        <div class="content-with-sidebar">
            <main class="main-feed">
                <article class="post-detail">
                    <!-- Meta -->
                    <div class="detail-meta">
                        <span class="post-card-kat post-card-kat--einsa-tze">Einsätze</span>
                        <time>@post.Datum.ToString("dddd, d. MMMM yyyy – HH:mm") Uhr</time>
                    </div>

                    <!-- Einsatz-Infobox -->
                    <div class="einsatz-infobox">
                        <div class="eib-row"><span class="eib-label">Einsatztyp</span><span>@post.EinsatzTyp</span></div>
                        <div class="eib-row"><span class="eib-label">Einsatzort</span><span>📍 @post.EinsatzOrt</span></div>
                        <div class="eib-row"><span class="eib-label">Alarmzeit</span><span>🕐 @post.EinsatzZeit</span></div>
                        <div class="eib-row"><span class="eib-label">Einsatzkräfte</span><span>👥 @post.EinsatzKraefte Personen</span></div>
                    </div>

                    <!-- Platzhalterbild -->
                    <div class="detail-img">
                        <img src="@DS.GetMainImageSrc(post)" class="hero-bg-img" alt="@post.Titel" />
                    </div>

                    <!-- Volltext -->
                    <div class="detail-body">
                        <p>@post.Volltext</p>
                    </div>

                    @if (post.Bilder != null && post.Bilder.Count > 0)
                    {
                        <div class="ff-carousel">
                            <div class="ff-carousel__track">
                                @for (int i = 0; i < post.Bilder.Count; i++)
                                {
                                    <div class="ff-carousel__slide @(i == currentIndex ? "ff-carousel__slide--active" : "")">
                                        <img src="img/@post.Bilder[i]" alt="Einsatzbild @(i + 1)" />
                                        <br/>
                                    </div>
                                }
                            </div>

                            <button class="ff-carousel__btn ff-carousel__btn--prev"
                                    @onclick="Prev" aria-label="Zurück">&#8249;</button>
                            <button class="ff-carousel__btn ff-carousel__btn--next"
                                    @onclick="Next" aria-label="Weiter">&#8250;</button>

                            <div class="ff-carousel__dots">
                                @for (int i = 0; i < post.Bilder.Count; i++)
                                {
                                    var idx = i;
                                    <button class="ff-carousel__dot @(i == currentIndex ? "ff-carousel__dot--active" : "")"
                                            @onclick="() => GoTo(idx)"
                                            aria-label="Slide @(i + 1)">
                                    </button>
                                }
                            </div>

                            <div class="ff-carousel__counter">
                                @(currentIndex + 1) / @post.Bilder.Count
                            </div>
                        </div>
                    }

                    <a href="/einsaetze" class="back-link">← Zurück zur Einsatzübersicht</a>
                </article>
            </main>

        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private Post? post;
    private int currentIndex = 0;

    protected override void OnParametersSet()
    {
        post = DS.GetPost(Slug);
        currentIndex = 0;
    }

    private void Next()
    {
        if (post?.Bilder is null || post.Bilder.Count == 0) return;
        currentIndex = (currentIndex + 1) % post.Bilder.Count;
    }

    private void Prev()
    {
        if (post?.Bilder is null || post.Bilder.Count == 0) return;
        currentIndex = (currentIndex - 1 + post.Bilder.Count) % post.Bilder.Count;
    }

    private void GoTo(int index) => currentIndex = index;
}
