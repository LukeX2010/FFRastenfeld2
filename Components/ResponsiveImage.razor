@inject DataService DS

@{
    var image = DS.GetImageDimensions(Src);
}
<img src="@Src"
     width="@image.Width" height="@image.Height" alt="@Alt" class="@CssClass"
     loading="@(Eager ? "eager" : "lazy")" fetchpriority="@(Priority ? "high" : null)" decoding="async" @attributes="Attributes" />

@code {
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter, EditorRequired] public string Alt { get; set; } = "";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Eager { get; set; }
    [Parameter] public bool Priority { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
