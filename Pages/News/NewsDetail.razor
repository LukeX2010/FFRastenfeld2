@* ── News Detail ── *@
@page "/news/{Slug}"
@inject DataService DS
@inject IJSRuntime JS

<PageTitle>@(post?.GetPageTitle() ?? "Beitrag | FF Rastenfeld")</PageTitle>

@if (post is null)
{
<div class="container" style="padding:4rem 1.5rem;text-align:center">
    <p>Beitrag nicht gefunden. <a href="/news">← Zur Nachrichtenübersicht</a></p>
</div>
}
else
{
<PageHero Title="@post.Titel" ParentLabel="Aktuelle Meldungen" ParentHref="/news"/>
<div class="site-body container">
    <div class="content-with-sidebar">
        <div class="main-feed">
            <article class="post-detail">
                <div class="detail-meta">
                    <span class="post-card-kat post-card-kat--ff-news">FF-News</span>
                    <time>@post.Datum.ToString("d. MMMM yyyy")</time>
                </div>
                <div class="detail-img">
                    <ResponsiveImage Src="@DS.GetMainImageSrc(post)" Alt="@DS.GetMainImageAlt(post)" CssClass="hero-bg-img" Eager="true" />
                </div>
                <div class="detail-body"><p class="post-copy">@post.Volltext</p></div>

                @if (post.Bilder is { Count: > 0 })
                {
                    <PostImageCarousel Images="post.Bilder" ImageAltPrefix="Bild" />
                }

                <a href="/news" class="back-link">← Zurück zu FF-News</a>
                <PostNavigation Current="@post" SectionPath="/news" />
            </article>
        </div>
    </div>
</div>
}

@code {
[Parameter] public string Slug { get; set; } = "";
private Post? post;

protected override void OnParametersSet()
{
post = DS.GetPost(Slug, "FF-News");
}
}
