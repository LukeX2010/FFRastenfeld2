@page "/fahrzeuge/{Id:int}"
@inject DataService DS

<PageTitle>@(fz?.Name ?? "Fahrzeug") – Freiwillige Feuerwehr Rastenfeld, NÖ</PageTitle>

@if (fz is null)
{
    <div class="container" style="padding:4rem 1.5rem;text-align:center"><p>Fahrzeug nicht gefunden. <a href="/fahrzeuge">← Zur Fahrzeugliste</a></p></div>
}
else
{
    <PageHero Title="@fz.Name" Subtitle="@GetSubtitle(fz)" ParentLabel="Fuhrparkübersicht" ParentHref="/fahrzeuge" />

    <div class="site-body container">
        <div class="content-with-sidebar">
            <div class="main-feed">
                <article class="post-detail">

                    <PhotoGallery Photos="@(new[] { new GalleryPhoto($"img/{GetFahrzeugBild(fz)}.jpeg", fz.Name) })" Label="@fz.Name" />

                    <div class="fz-detail-meta">
                        <div class="fdm-item"><span>Bezeichnung</span><strong>@fz.Name</strong></div>
                        <div class="fdm-item"><span>Kurzzeichen</span><strong>@fz.Kuerzel</strong></div>
                        @if (!string.IsNullOrWhiteSpace(fz.Funkrufname))
                        {
                            <div class="fdm-item"><span>Funkrufname</span><strong>@fz.Funkrufname</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(fz.Hersteller))
                        {
                            <div class="fdm-item"><span>Hersteller</span><strong>@fz.Hersteller</strong></div>
                        }
                        <div class="fdm-item"><span>Baujahr</span><strong>@fz.Baujahr</strong></div>
                    </div>

                    <h2 class="vehicle-detail-heading">Beschreibung</h2>
                    <p>@fz.Beschreibung</p>

                    <h2 class="vehicle-detail-heading">Beladung & Ausstattung</h2>
                    <ul class="ausstattung-list">
                        @foreach (var a in fz.Ausstattung)
                        {
                            <li><span class="check-icon">✓</span> @a</li>
                        }
                    </ul>

                    <div class="fz-nav">
                        <a href="/fahrzeuge" class="btn btn-outline-small">← Alle Fahrzeuge</a>
                        @if (previous is not null)
                        { <a href="/fahrzeuge/@previous.Id" class="btn btn-outline-small">← @previous.Name</a> }
                        @if (next is not null)
                        { <a href="/fahrzeuge/@next.Id" class="btn btn-outline-small">@next.Name →</a> }
                    </div>

                </article>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Fahrzeug? fz;
    private Fahrzeug? previous;
    private Fahrzeug? next;

    protected override void OnParametersSet()
    {
        var vehicles = DS.GetFahrzeuge();
        var index = vehicles.FindIndex(vehicle => vehicle.Id == Id);
        fz = index >= 0 ? vehicles[index] : null;
        previous = index > 0 ? vehicles[index - 1] : null;
        next = index >= 0 && index + 1 < vehicles.Count ? vehicles[index + 1] : null;
    }

    private static string GetFahrzeugBild(Fahrzeug f) =>
        string.IsNullOrWhiteSpace(f.BildDatei) ? f.Kuerzel : f.BildDatei;

    private static string GetSubtitle(Fahrzeug f)
    {
        var details = new List<string> { f.Kuerzel };

        if (!string.IsNullOrWhiteSpace(f.Funkrufname))
        {
            details.Add(f.Funkrufname);
        }

        details.Add($"Bj. {f.Baujahr}");
        return string.Join(" – ", details);
    }
}
