@* Wiederverwendbare Post-Karte für Einsätze, News und Ausbildung *@

@inject DataService DS

<article class="post-card">
    <a href="@PostHref" class="post-card-img-link">
        <div class="post-card-img">
            <img src="@DS.GetMainImageSrc(Post)" class="hero-bg-img" alt="@Post.Titel"/>
        </div>
    </a>
    <div class="post-card-body">
        <time class="post-date">@Post.Datum.ToString("d. MMMM yyyy")</time>
        <h3><a href="@PostHref">@Post.Titel</a></h3>
        @if (!string.IsNullOrEmpty(Post.EinsatzTyp))
        {
            <div class="post-einsatz-meta">
                <span>⚡ @Post.EinsatzTyp</span>
                @if (!string.IsNullOrEmpty(Post.EinsatzOrt))
                { <span>📍 @Post.EinsatzOrt</span> }
                @if (Post.EinsatzKraefte.HasValue)
                { <span>👥 @Post.EinsatzKraefte Kräfte</span> }
            </div>
        }
        <p>@Post.Kurztext</p>
        <a href="@PostHref" class="read-more">Weiterlesen →</a>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = default!;

    private string PostHref => Post.Kategorie switch
    {
        "Einsätze" => $"/einsaetze/{Post.Slug}",
        "Ausbildung" => $"/ausbildung/{Post.Slug}",
        _ => $"/news/{Post.Slug}"
    };
}
