@* ── Galerie ── *@
@page "/galerie"
@inject DataService DS

<PageTitle>Galerie mit Einsatz- und Übungsfotos | FF Rastenfeld</PageTitle>
<PageHero Title="Galerie" Subtitle="Fotos aus Einsätzen, Übungen und Veranstaltungen der FF Rastenfeld" />


<div class="site-body container">
    <div class="content-with-sidebar">
        <main class="main-feed">

            <div class="galerie-filter">
                @foreach (var kat in kategorien)
                {
                    <button class="filter-pill @(activeKat==kat?"active":"")" @onclick="()=>activeKat=kat">@kat</button>
                }
            </div>

            <div class="galerie-grid">
                @foreach (var b in GetFiltered())
                {
                    <button type="button" class="gal-item" aria-label="@($"{b.Titel} im Foto-Viewer öffnen")" @onclick="() => OpenPhoto(b)">
                        <div class="gal-placeholder"><ResponsiveImage Src="@GetGalleryImageSrc(b)" Alt="@(string.IsNullOrWhiteSpace(b.Untertitel) ? $"Foto: {b.Titel}" : b.Untertitel)" CssClass="hero-bg-img" /></div>
                        <div class="gal-hover">
                            <span class="gal-title">@b.Titel</span>
                            <span class="gal-kat">@b.Kategorie · @b.Jahr</span>
                        </div>
                    </button>
                }
            </div>

            <PhotoGallery @ref="_viewer" Photos="FilteredPhotos" ShowPreview="false" Label="Galerie der FF Rastenfeld" />

        </main>
        <aside class="sidebar">
            <!-- Suche -->

            <!-- Letzter Einsatz -->
            <div class="sidebar-widget sidebar-widget--red">
                <h3>⚡ Letzter Einsatz</h3>
                @{var last = DS.GetEinsaetze().FirstOrDefault();}
                @if (last != null)
                {
                <p class="sidebar-einsatz-typ">@last.EinsatzTyp</p>
                <p class="sidebar-einsatz-title"><a href="/einsaetze/@last.Slug">@last.Titel</a></p>
                <time>@last.Datum.ToString("dd.MM.yyyy – HH:mm") Uhr</time>
                }
            </div>

            <!-- Kategorien -->
            <div class="sidebar-widget">
                <h3>Kategorien</h3>
                <ul class="sidebar-cats">
                    <li><a href="/einsaetze">Einsätze <span>@DS.GetByKategorie("Einsätze").Count</span></a></li>
                    <li><a href="/news">FF-News <span>@DS.GetByKategorie("FF-News").Count</span></a></li>
                    <li><a href="/ausbildung">Ausbildung <span>@DS.GetByKategorie("Ausbildung").Count</span></a></li>
                </ul>
            </div>

            <!-- Links -->
            <div class="sidebar-widget">
                <h3>Links</h3>
                <ul class="sidebar-links">
                    <li><a href="https://www.noelfv.at" target="_blank" rel="noopener noreferrer">NÖ Landesfeuerwehrverband</a></li>
                    <li><a href="https://www.bfk-krems.at" target="_blank" rel="noopener noreferrer">BFK Krems-Land</a></li>
                    <li><a href="https://www.noelfv.at/wastl" target="_blank" rel="noopener noreferrer">WASTL Einsatzmonitor</a></li>
                    <li><a href="https://www.noelfv.at/lfws" target="_blank" rel="noopener noreferrer">NÖ Landesfeuerwehrschule</a></li>
                    <li><a href="https://www.rastenfeld.at" target="_blank" rel="noopener noreferrer">Marktgemeinde Rastenfeld</a></li>
                </ul>
            </div>

            <!-- Mitglied werden Banner -->
            <div class="sidebar-widget sidebar-widget--join">
                <p>🧑‍🚒 <strong>Werde Mitglied!</strong></p>
                <p>Du möchtest helfen? Wir freuen uns über jede Verstärkung!</p>
                <a href="/kontakt" class="btn btn-primary" style="width:100%;text-align:center;margin-top:.5rem;">Jetzt mitmachen</a>
            </div>
        </aside>

    </div>
</div>

@code {
    record GalBild(string Titel, string ImageSrc, string Kategorie, int Jahr,string Untertitel, DateTime Datum);

    private List<GalBild> bilder = new()
    {
        new("Florianimesse 2025","florianimesse2025_1","Ausrückungen",2025, "", new DateTime(2025, 1, 1)),
        new("Florianimesse 2025","florianimesse2025_2","Ausrückungen",2025, "", new DateTime(2025, 1, 1)),
        new("Florianimesse 2025","florianimesse2025_3","Ausrückungen",2025, "", new DateTime(2025, 1, 1)),
        new("Florianimesse 2026","florianimesse-rastenfeld-2026","Ausr\u00FCckungen",2026, "Florianimesse am Marktplatz Rastenfeld", new DateTime(2026, 5, 14)),
        new("Florianimesse 2026","florianimesse-rastenfeld-2026-ausrueckung","Ausr\u00FCckungen",2026, "Gemeinsamer Auszug am Marktplatz Rastenfeld", new DateTime(2026, 5, 14)),
        new("Tut Gut Wandertag","Tutgut_2026","Veranstaltungen",2026, "", new DateTime(2026, 4, 26)),
        new("Ehrungen des Abschnittsfeuerwehrtages","Johnyehrung","Sonstiges",2025, "Ehrenkommandant Johann Herzog erhielt das Verdienstzeichen 2.Klasse des NÖ Landesfeuwerwehrverbandes.", new DateTime(2025, 1, 1)),
        new("Ehrungen des Abschnittsfeuerwehrtages","Kroepflehrung","Sonstiges",2025, "EOLM Friedrich Kröpfl wurde für die 60 jährige Feuerwehrtätigkeit geehrt.", new DateTime(2025, 1, 1)),
        

    };

    public List<Post> alleinsätze = new();


    protected override void OnInitialized()
    {
        alleinsätze = DS.GetEinsaetze();
        addeinsätze();
    }
    public void addeinsätze()
    {
        foreach (var einsätze in alleinsätze)
        {
            if (einsätze.Bilder is { Count: > 0 })
            {
                foreach (var foto in einsätze.Bilder.Where(b => !string.IsNullOrWhiteSpace(b.Pfad)))
                    bilder.Add(new GalBild(einsätze.Titel, DS.GetImageSrc(foto.Pfad), einsätze.Kategorie, einsätze.Datum.Year, foto.Beschreibung ?? "", einsätze.Datum));
            }
            else
            {
                bilder.Add(new GalBild(einsätze.Titel, DS.GetMainImageSrc(einsätze), einsätze.Kategorie, einsätze.Datum.Year, "", einsätze.Datum));
            }
        }
        
    }
    
    private string GetGalleryImageSrc(GalBild bild)
    {
        var src = bild.ImageSrc?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(src))
        {
            return "img/keinbild.jpeg";
        }

        if (Uri.TryCreate(src, UriKind.Absolute, out _) ||
            src.StartsWith("/", StringComparison.Ordinal) ||
            src.StartsWith("img/", StringComparison.OrdinalIgnoreCase))
        {
            return src;
        }

        return DS.GetImageSrc($"{src}.jpeg");
    }

    private string activeKat = "Alle";
    private PhotoGallery? _viewer;
    private IReadOnlyList<GalleryPhoto> FilteredPhotos => GetFiltered().Select(b => new GalleryPhoto(GetGalleryImageSrc(b), b.Titel, string.IsNullOrWhiteSpace(b.Untertitel) ? $"{b.Titel} · {b.Kategorie} · {b.Jahr}" : $"{b.Titel} · {b.Untertitel}")).ToList();

    private List<GalBild> GetFiltered() => (activeKat == "Alle" ? bilder : bilder.Where(b => b.Kategorie == activeKat))
        .OrderByDescending(b => b.Datum)
        .ToList();

    private List<string> kategorien = new() { "Alle","Einsätze","Übungen","Ausbildungen & Kurse","Veranstaltungen", "Ausrückungen","Sonstiges" };

    private Task OpenPhoto(GalBild photo) => _viewer?.OpenAsync(GetFiltered().IndexOf(photo)) ?? Task.CompletedTask;
}
