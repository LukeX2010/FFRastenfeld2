<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FFRastenfeld</RootNamespace>
    <WasmEmitSourceMap>true</WasmEmitSourceMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="AdminServer\**\*.cs" />
    <Content Remove="AdminServer\**" />
    <None Remove="AdminServer\**" />
  </ItemGroup>
  <Target Name="PublishWasmSourceMaps" AfterTargets="Publish" Condition="'$(RunAOTCompilation)' != 'true'">
    <ItemGroup>
      <_WasmSourceMap Include="$(OutputPath)wwwroot/_framework/dotnet*.js.map" />
    </ItemGroup>
    <Copy SourceFiles="@(_WasmSourceMap)" DestinationFolder="$(PublishDir)wwwroot/_framework" SkipUnchangedFiles="true" />
  </Target>
</Project>
