# Kommagetrennte WhatsApp-Gruppen-IDs, z.B.
# ALLOWED_CHAT_IDS=120363123456789012@g.us,120363987654321098@g.us
ALLOWED_CHAT_IDS=120363407513474923@g.us

# Wenn false, werden auch Nachrichten gespeichert, die du selbst vom verknuepften WhatsApp-Konto sendest.
IGNORE_OWN_MESSAGES=false

# Wenn true, speichert der Bot testweise alle Gruppen-/Community-Nachrichten.
# Erst nach bewusstem Setzen auf true verwenden.
SAVE_ALL_GROUPS=false

# Wenn true, antwortet der Bot in WhatsApp mit Kategorie und fehlenden Infos.
REPLY_IN_WHATSAPP=true

# Wenn true, schreibt der Bot beim Verbinden kurz in die freigegebene Gruppe.
STARTUP_ONLINE_MESSAGE=true

# Nachrichten/Bilder aus derselben Gruppe innerhalb dieser Zeit werden in einen Ordner gebuendelt.
BATCH_WINDOW_MS=15000

# So lange wartet der Bot auf Zusatzinfos zu einem unvollstaendigen gespeicherten Ordner.
FOLLOWUP_WINDOW_MS=1800000

# Zielordner relativ zum Projektroot.
OUTPUT_DIR=../wwwroot/img/Bearbeiten

# Wenn true, werden Gruppen-IDs in der Konsole angezeigt.
PRINT_CHAT_IDS=true
