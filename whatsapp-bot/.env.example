# Kommagetrennte WhatsApp-Gruppen-IDs, z.B.
# ALLOWED_CHAT_IDS=120363123456789012@g.us,120363987654321098@g.us
ALLOWED_CHAT_IDS=120363407513474923@g.us

# Zielordner relativ zum Ordner whatsapp-bot.
OUTPUT_DIR=../wwwroot/img/Bearbeiten

# Wenn true, antwortet der Bot in WhatsApp mit Status, Analyse und Review-Befehlen.
REPLY_IN_WHATSAPP=true

# Wenn true, schreibt der Bot beim Verbinden kurz in die freigegebene Gruppe.
STARTUP_ONLINE_MESSAGE=true
WHATSAPP_WEB_VERSION=2.3000.1035194821

# Wenn false, werden auch Nachrichten gespeichert, die du selbst vom verknuepften WhatsApp-Konto sendest.
IGNORE_OWN_MESSAGES=false

# Wenn true, speichert der Bot testweise alle Gruppen-/Community-Nachrichten.
SAVE_ALL_GROUPS=false

# Wenn true, werden Gruppen-IDs in der Konsole angezeigt.
PRINT_CHAT_IDS=true

# Nachrichten/Bilder aus derselben Gruppe innerhalb dieser Zeit werden in einen Ordner gebuendelt.
BATCH_WINDOW_MS=15000
REQUIRE_START_COMMAND=true

# So lange wartet der Bot auf Zusatzinfos zu einem unvollstaendigen gespeicherten Ordner.
FOLLOWUP_WINDOW_MS=1800000

# KI ueber Gemini. Wenn Gemini nicht erreichbar ist, speichert der Bot weiter und antwortet mit Fallback.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_TIMEOUT_MS=180000
GEMINI_API_KEY=dein-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_GOOGLE_SEARCH=true
GEMINI_SEND_IMAGES=true
REDACT_SENSITIVE_DATA=true

# Alte Ollama-Werte bleiben kompatibel, werden aber nur genutzt, wenn AI_PROVIDER=ollama gesetzt wird.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=4096

# Sichere Recherche-Schnittstelle. Ohne Provider wird nur research.json mit Hinweis geschrieben.
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_PROVIDER=bing
WEB_RESEARCH_TIMEOUT_MS=8000
WEB_RESEARCH_MAX_RESULTS=5
WEB_RESEARCH_FETCH_PAGES=true

# Publishing bleibt standardmaessig manuell.
AUTO_PUBLISH=false
REQUIRE_APPROVAL=true
# Fuer Netlify-freie Inhaltsupdates auf ein separates GitHub-Pages-Content-Repo zeigen lassen.
# Beispiel: POSTS_JSON_PATH=../../ffrastenfeld-content/posts.json
# Beispiel: PUBLIC_IMAGE_DIR=../../ffrastenfeld-content/img/posts
POSTS_JSON_PATH=../wwwroot/data/posts.json
PUBLIC_IMAGE_DIR=../wwwroot/img/posts
