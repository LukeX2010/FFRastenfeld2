@using Microsoft.AspNetCore.Components.Routing
@inject DataService DS
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

@if (!postsReady)
{
    <LoadingSkeleton ShowNavigation="true" />
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layouts.MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>404 - Seite nicht gefunden | FF Rastenfeld</PageTitle>
            <LayoutView Layout="@typeof(Layouts.MainLayout)">
                <div class="not-found">
                    <h1>404</h1>
                    <p>Diese Seite wurde nicht gefunden.</p>
                    <a href="/" class="btn btn-primary">Zur Startseite</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool postsReady;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += UpdatePageMetadata;
        await DS.EnsurePostsLoadedAsync();
        postsReady = true;
    }

    private void UpdatePageMetadata(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() => JS.InvokeVoidAsync("ffrUpdatePageMetadata", args.Location).AsTask());

    public void Dispose() => Navigation.LocationChanged -= UpdatePageMetadata;
}
