@inject DataService DS

<PhotoGallery Photos="_photos" Label="@ImageAltPrefix" />

@code {
    [Parameter] public List<PostBild>? Images { get; set; }
    [Parameter] public string ImageAltPrefix { get; set; } = "Bilder";
    private IReadOnlyList<GalleryPhoto> _photos = [];

    protected override void OnParametersSet()
    {
        _photos = (Images ?? []).Where(p => !string.IsNullOrWhiteSpace(p.Pfad))
            .Select((p, i) => new GalleryPhoto(DS.GetImageSrc(p.Pfad),
                string.IsNullOrWhiteSpace(p.Beschreibung) ? $"{ImageAltPrefix} {i + 1}" : p.Beschreibung,
                string.IsNullOrWhiteSpace(p.Beschreibung) ? null : p.Beschreibung)).ToList();

    }
}
