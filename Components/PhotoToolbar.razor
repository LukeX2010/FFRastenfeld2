<div class="photo-toolbar" role="group" aria-label="Fotosteuerung">
    @if (Count > 1)
    {
        <button type="button" data-photo-action="previous" aria-label="Vorheriges Bild">‹</button>
        <output class="photo-toolbar-counter" aria-live="polite">@(Index + 1) / @Count</output>
        <button type="button" data-photo-action="next" aria-label="Nächstes Bild">›</button>
        <span class="photo-toolbar-divider" aria-hidden="true"></span>
    }
    <button type="button" data-photo-action="zoom-out" aria-label="Bild verkleinern">−</button>
    <button type="button" class="photo-toolbar-reset" data-photo-action="reset" aria-label="Bildzoom zurücksetzen"><span data-photo-zoom>100 %</span><span aria-hidden="true">↺</span></button>
    <button type="button" data-photo-action="zoom-in" aria-label="Bild vergrößern">+</button>
    <span class="photo-toolbar-divider" aria-hidden="true"></span>
    @if (Modal)
    {
        <button type="button" data-photo-action="close" aria-label="Foto-Vollbild schließen"><span aria-hidden="true">×</span><span class="photo-toolbar-word">Schließen</span></button>
    }
    else
    {
        <button type="button" data-photo-action="open" aria-label="Foto im Vollbild öffnen"><span aria-hidden="true">⛶</span><span class="photo-toolbar-word">Vollbild</span></button>
    }
</div>

@code {
    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Modal { get; set; }
}
